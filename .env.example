# .env.example — Template for environment configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# NEVER include real API tokens here.

# ─── Application ───────────────────────────────────────────────────────────
DEBUG=false
API_HOST=127.0.0.1
API_PORT=8000

# ─── Limits ────────────────────────────────────────────────────────────────
MAX_BITS=100000
MIN_BITS=100
DEFAULT_BITS=10000

# ─── Database ──────────────────────────────────────────────────────────────
# DB_PATH defaults to data/qrng.db relative to the project root.
# DB_PATH=data/qrng.db

# ─── NIST Tests ────────────────────────────────────────────────────────────
NIST_ALPHA=0.01

# ─── IBM Quantum (OPTIONAL — not required for local simulator use) ──────────
# Set these ONLY if you have an IBM Quantum account.
# NEVER share or commit your real token.
# IBM_QUANTUM_TOKEN=your_token_here
# IBM_QUANTUM_INSTANCE=ibm-q/open/main
# IBM_QUANTUM_BACKEND=ibm_brisbane
# HARDWARE_JOB_TIMEOUT_SECONDS=300
